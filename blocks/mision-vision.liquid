{%- doc -%}
  Visión y Misión de la página Quiénes somos (sections/quienes-somos.liquid), como dos tarjetas
  (.babysam-card, assets/base.css, la misma superficie de testimonios y franja de confianza):
  ícono en círculo --bs-turquoise (ojo para Visión, corazón para Misión), título Poppins 600 y
  texto --bs-text a 17px con interlineado 1,7. Animación de entrada al hacer scroll (fade +
  slide-up, assets/babysam-animations.js, variante 'fadeslide').
{%- enddoc -%}

<div class="mision-vision" {{ block.shopify_attributes }}>
  <article class="mision-vision__item babysam-card bs-reveal bs-reveal--fadeslide">
    <div class="mision-vision__head">
      <span class="mision-vision__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
      </span>
      <h2 class="mision-vision__heading">{{ block.settings.heading_1 | escape }}</h2>
    </div>
    <div class="mision-vision__text">
      {{ block.settings.text_1 }}
    </div>
  </article>

  <article class="mision-vision__item babysam-card bs-reveal bs-reveal--fadeslide">
    <div class="mision-vision__head">
      <span class="mision-vision__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.4 4.5 6.9 4.5c2 0 3.6 1.1 5.1 3 1.5-1.9 3.1-3 5.1-3 3.5 0 5.5 3.5 4.2 6.8-1.8 4.6-9.3 9.2-9.3 9.2Z" />
        </svg>
      </span>
      <h2 class="mision-vision__heading">{{ block.settings.heading_2 | escape }}</h2>
    </div>
    <div class="mision-vision__text">
      {{ block.settings.text_2 }}
    </div>
  </article>
</div>

{% stylesheet %}
  .mision-vision {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
  }

  .mision-vision__item {
    padding: 24px 22px;

    @media screen and (min-width: 750px) {
      padding: 28px 30px;
    }
  }

  .mision-vision__head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-block-end: 12px;
  }

  .mision-vision__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--bs-turquoise);
    color: #fff;
  }

  .mision-vision__icon svg {
    width: 24px;
    height: 24px;
  }

  /* Es <h2> por jerarquía (debajo del <h1> de la página), pero con estilo de título de
     tarjeta: Poppins 600. La regla global de h1/h2 pone Fredoka con !important, así que el
     !important acá es la única forma de devolverle Poppins a este título puntual. */
  .mision-vision .mision-vision__heading {
    margin: 0;
    color: var(--bs-text);
    font-family: var(--font-body--family) !important;
    font-size: var(--bs-h3-size);
    font-weight: 600 !important;
    line-height: 1.3;
  }

  .mision-vision__text,
  .mision-vision__text :is(p, li) {
    color: var(--bs-text);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .mision-vision__text > * {
    margin: 0;
  }

  .mision-vision__text > * + * {
    margin-block-start: 0.75em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Visión y Misión",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading_1",
      "label": "Título 1",
      "default": "Visión"
    },
    {
      "type": "richtext",
      "id": "text_1",
      "label": "Texto 1"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Título 2",
      "default": "Misión"
    },
    {
      "type": "richtext",
      "id": "text_2",
      "label": "Texto 2"
    }
  ],
  "presets": [
    {
      "name": "Visión y Misión"
    }
  ]
}
{% endschema %}
