{%- doc -%}
  Formulario "Crea tu Lista de Baby Shower": arma un mensaje de WhatsApp con los datos y lo abre
  (no guarda nada en Shopify). Se usa en la página Baby Shower, en Club de Mamás y en el home
  (sección oculta).

  - Estilo compartido con el formulario de contacto: .form--babysam (campos, foco, errores,
    etiquetas) y .button--babysam-wa (botón verde), en assets/base.css. Acá solo lo propio.
  - Validación en español compartida (@theme/form-babysam) y armado del mensaje en
    assets/baby-shower-form.js. El formulario va con `novalidate`.
  - Todo el CSS está prefijado con .baby-shower-form: la versión anterior traía reglas globales
    (.button, .form-field, .form-title…) en un <style> en línea que restilaban todos los botones
    de la página donde aparecía el formulario.
{%- enddoc -%}

{%- liquid
  # Número: solo dígitos y con 57 (mismo criterio que snippets/whatsapp-url.liquid).
  assign wa = block.settings.whatsapp_number | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '+' | remove: '.'
  if wa != blank
    assign wa_pref = wa | slice: 0, 2
    unless wa_pref == '57'
      assign wa = '57' | append: wa
    endunless
  endif

  assign intro = block.settings.message_intro | default: '¡Hola, Babysam! 👋🍼'
  assign cierre = block.settings.message_closing | default: '¿Me confirman la disponibilidad? 💕'
  assign uid = block.id
-%}

<div
  class="baby-shower-form baby-shower-form-container form--babysam{% if block.settings.inherit_color_scheme == false %} color-{{ block.settings.color_scheme }}{% endif %}"
  {{ block.shopify_attributes }}
>
  <h2 class="baby-shower-form__title">{{ block.settings.form_title }}</h2>

  {%- if block.settings.form_description != blank -%}
    <div class="baby-shower-form__intro">{{ block.settings.form_description }}</div>
  {%- endif -%}

  <script src="{{ 'baby-shower-form.js' | asset_url }}" type="module" fetchpriority="low"></script>

  <form
    class="baby-shower-form__form"
    novalidate
    data-babysam-bs
    data-whatsapp="{{ wa }}"
    data-intro="{{ intro | escape }}"
    data-cierre="{{ cierre | escape }}"
  >
    <div class="baby-shower-form__grid">
      <div class="form-babysam__field">
        <label class="form-babysam__label" for="ParentName-{{ uid }}">Nombre de los futuros padres *</label>
        <input
          type="text"
          id="ParentName-{{ uid }}"
          class="form-babysam__input"
          name="parent_name"
          autocomplete="name"
          placeholder="Ej. Ana y Carlos"
          aria-describedby="ParentName-{{ uid }}-error"
          data-babysam-rule="required"
          data-babysam-msg="Escribe el nombre de los futuros padres."
          data-bs-campo="padres"
        >
        <p class="form-babysam__error" id="ParentName-{{ uid }}-error" hidden></p>
      </div>

      <div class="form-babysam__field">
        <label class="form-babysam__label" for="Email-{{ uid }}">Correo electrónico *</label>
        <input
          type="email"
          id="Email-{{ uid }}"
          class="form-babysam__input"
          name="email"
          autocomplete="email"
          spellcheck="false"
          autocapitalize="off"
          placeholder="Ej. ana@correo.com"
          aria-describedby="Email-{{ uid }}-error"
          data-babysam-rule="email"
          data-babysam-required
          data-bs-campo="correo"
        >
        <p class="form-babysam__error" id="Email-{{ uid }}-error" hidden></p>
      </div>

      <div class="form-babysam__field">
        <label class="form-babysam__label" for="Phone-{{ uid }}">Número de teléfono *</label>
        <input
          type="tel"
          id="Phone-{{ uid }}"
          class="form-babysam__input"
          name="phone"
          autocomplete="tel"
          inputmode="tel"
          placeholder="Ej. 310 123 4567"
          aria-describedby="Phone-{{ uid }}-error"
          data-babysam-rule="phone"
          data-babysam-required
          data-bs-campo="telefono"
        >
        <p class="form-babysam__error" id="Phone-{{ uid }}-error" hidden></p>
      </div>

      <div class="form-babysam__field">
        <label class="form-babysam__label" for="Date-{{ uid }}">Fecha probable para la cita en tienda</label>
        <input
          type="date"
          id="Date-{{ uid }}"
          class="form-babysam__input"
          name="date"
          data-bs-campo="fecha"
        >
      </div>

      <div class="form-babysam__field">
        <label class="form-babysam__label" for="GuestCount-{{ uid }}">Número de invitados estimados</label>
        <input
          type="number"
          id="GuestCount-{{ uid }}"
          class="form-babysam__input"
          name="guest_count"
          min="1"
          step="1"
          inputmode="numeric"
          placeholder="Ej. 30"
          aria-describedby="GuestCount-{{ uid }}-error"
          data-babysam-rule="positive"
          data-bs-campo="invitados"
        >
        <p class="form-babysam__error" id="GuestCount-{{ uid }}-error" hidden></p>
      </div>

      <div class="form-babysam__field baby-shower-form__full">
        <label class="form-babysam__label" for="Comments-{{ uid }}">Comentarios adicionales</label>
        <textarea
          id="Comments-{{ uid }}"
          class="form-babysam__input form-babysam__textarea"
          name="comments"
          rows="4"
          placeholder="Ej. Prefiero en la mañana, o tengo una duda sobre…"
          data-bs-campo="comentarios"
        ></textarea>
      </div>
    </div>

    <p class="baby-shower-form__nota">Al enviar, se abrirá WhatsApp con tus datos listos 💬</p>

    <button type="submit" class="button--babysam-wa baby-shower-form__submit">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M12 2a10 10 0 0 0-8.6 15.09L2 22l5.05-1.32A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3 .78.8-2.92-.2-.31A8.2 8.2 0 1 1 12 20.2Z" />
        <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.38-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.07-.13-.27-.2-.57-.35Z" />
      </svg>
      <span>{{ block.settings.button_label | default: 'Agendar cita por WhatsApp' | escape }}</span>
    </button>

    <div class="baby-shower-form__estado" role="status" hidden>
      <p>¡Listo! 💕 Abrimos WhatsApp con tus datos. Solo tienes que tocar «Enviar».</p>
      <p>¿No se abrió? <a class="baby-shower-form__respaldo" href="#" target="_blank" rel="noopener">Ábrelo aquí</a>.</p>
    </div>

    {%- if wa == blank and request.design_mode -%}
      <p class="form-babysam__error">Configura el número de WhatsApp en los ajustes del bloque.</p>
    {%- endif -%}
  </form>
</div>

{% stylesheet %}
  /* Todo prefijado con .baby-shower-form. Campos, foco y errores: .form--babysam (base.css). */
  .baby-shower-form {
    --bsf-titulo: var(--bs-turquoise); /* token del sistema de diseño (assets/base.css) */

    width: 100%;
    max-width: 760px;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-radius: 32px;
    background-color: #fff;
    box-shadow: 0 12px 32px rgb(90 63 40 / 0.1);
    color: var(--babysam-texto);
  }

  /* Título limpio en Fredoka (regla global de h2 en base.css), sin cinta ni sombra. */
  .baby-shower-form .baby-shower-form__title {
    margin: 0 0 var(--margin-md);
    color: var(--bsf-titulo);
    font-size: var(--bs-h2-size);
    line-height: 1.15;
    text-align: center;
  }

  /* Recuadro informativo: crema suave, sin borde ni sombra, más discreto que los campos. */
  .baby-shower-form .baby-shower-form__intro {
    margin-block-end: var(--margin-xl);
    padding: var(--padding-md) var(--padding-lg);
    border-radius: 16px;
    background-color: #fffaf7;
    font-size: 0.9375rem;
    line-height: 1.5;
    text-align: center;
  }

  .baby-shower-form .baby-shower-form__intro p {
    margin: 0;
  }

  .baby-shower-form .baby-shower-form__intro p + p {
    margin-block-start: var(--margin-2xs);
  }

  .baby-shower-form .baby-shower-form__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-md);
  }

  @media screen and (min-width: 750px) {
    .baby-shower-form .baby-shower-form__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gap-md) var(--gap-lg);
    }

    .baby-shower-form .baby-shower-form__full {
      grid-column: 1 / -1;
    }
  }

  .baby-shower-form .baby-shower-form__nota {
    margin: var(--margin-xl) 0 var(--margin-xs);
    font-size: var(--font-size--sm);
    text-align: center;
  }

  /* Botón: .button--babysam-wa (verde compartido); acá solo el ancho. */
  .baby-shower-form .baby-shower-form__submit {
    display: flex;
    width: 100%;
  }

  .baby-shower-form .baby-shower-form__estado {
    margin-block-start: var(--margin-md);
    padding: var(--padding-md) var(--padding-lg);
    border: 1.5px solid var(--bs-turquoise-soft);
    border-radius: 16px;
    background-color: rgb(120 192 179 / 0.15);
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
  }

  .baby-shower-form .baby-shower-form__estado p {
    margin: 0;
  }

  .baby-shower-form .baby-shower-form__estado p + p {
    margin-block-start: var(--margin-2xs);
    font-weight: 400;
  }

  .baby-shower-form .baby-shower-form__estado a {
    color: inherit;
    text-decoration: underline;
  }

  /* Mobile, solo en secciones con video + este formulario (página Baby Shower): el formulario
     primero y el video después, centrado, para que el botón no quede escondido tras el video
     vertical. Club de Mamás (título + formulario, sin video) no se toca. */
  @media screen and (max-width: 749px) {
    .section-content-wrapper:has(> deferred-media):has(.baby-shower-form) > :has(.baby-shower-form) {
      order: -1;
    }

    .section-content-wrapper:has(> deferred-media):has(.baby-shower-form) > deferred-media {
      align-self: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Formulario de Baby Shower",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "form_title",
      "label": "Título del formulario",
      "default": "Crea tu Lista de Baby Shower"
    },
    {
      "type": "richtext",
      "id": "form_description",
      "label": "Descripción del formulario",
      "default": "<p>Agenda un recorrido personalizado en nuestra tienda para preparar la lista de regalos perfecta para tu bebé.</p><p>Además, evitas regalos repetidos o cosas que no usarás.</p>"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "Número de WhatsApp",
      "info": "Con o sin 57; se normaliza solo."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Agendar cita por WhatsApp"
    },
    {
      "type": "textarea",
      "id": "message_intro",
      "label": "Inicio del mensaje de WhatsApp",
      "info": "Va antes de los datos del formulario. Los *asteriscos* salen en negrita en WhatsApp.",
      "default": "¡Hola, Babysam! 👋🍼\nQuiero agendar una cita para crear mi *Lista de Baby Shower* 🎁"
    },
    {
      "type": "text",
      "id": "message_closing",
      "label": "Cierre del mensaje de WhatsApp",
      "default": "¿Me confirman la disponibilidad? 💕"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Ancho en escritorio",
      "options": [
        { "value": "fit-content", "label": "Ajustar al contenido" },
        { "value": "custom", "label": "Ancho personalizado" }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Ancho",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Ancho en móvil",
      "options": [
        { "value": "fit-content", "label": "Ajustar al contenido" },
        { "value": "custom", "label": "Ancho personalizado" }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Ancho",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "Heredar esquema de color",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Izquierda",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Derecha",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Formulario de Baby Shower",
      "category": "Formularios"
    }
  ]
}
{% endschema %}
