{%- comment -%}
  Página Quiénes somos (templates/page.catalogo.json). Contenido flexible (título de la página,
  logo y el bloque Visión y Misión en tarjetas) con el video vertical 9:16 en una columna
  angosta a la derecha. Proporciones por ancho: ver el bloque de CSS.
  El título es el de la página (Tienda online › Páginas), con el estilo de título de sección
  del sistema de diseño (.home-section-title: --bs-turquoise, --bs-h2-size).
{%- endcomment -%}

<div class="quienes-somos page-width">
  <div class="quienes-somos__grid{% if section.settings.video == blank %} quienes-somos__grid--sin-video{% endif %}">
    <div class="quienes-somos__content">
      <h1 class="quienes-somos__title home-section-title">{{ page.title | default: section.settings.fallback_title | escape }}</h1>

      {%- if section.settings.logo != blank -%}
        {%- assign logo_style = '--logo-width: ' | append: section.settings.logo_width | append: 'px;' -%}
        {{
          section.settings.logo
          | image_url: width: 640
          | image_tag:
            class: 'quienes-somos__logo',
            widths: '240, 320, 480, 640',
            sizes: '(min-width: 750px) 280px, 60vw',
            style: logo_style,
            loading: 'eager'
        }}
      {%- endif -%}

      {% content_for 'blocks' %}
    </div>

    {%- if section.settings.video != blank -%}
      <div class="quienes-somos__media">
        {{
          section.settings.video
          | video_tag:
            class: 'quienes-somos__video',
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            controls: false,
            image_size: '720x'
        }}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  /*
    Proporciones (el video es vertical 9:16):
    - Mobile: título, logo, tarjetas y el video centrado (máx. 320px).
    - 750-989px: contenido flexible con las tarjetas apiladas + video angosto a la derecha (280px).
    - Desde 990px: contenido flexible con Visión y Misión lado a lado + video a la derecha
      (máx. 360px = 640px de alto en 9:16), centrado verticalmente con el contenido.
    El marco del video fija la proporción 9:16 y el video la llena con object-fit: cover, sin
    estirarse a una caja más ancha.
  */
  .quienes-somos {
    padding-block: 24px 48px;

    @media screen and (min-width: 990px) {
      padding-block: 32px 64px;
    }
  }

  .quienes-somos__grid {
    display: grid;
    gap: 28px;

    @media screen and (min-width: 750px) {
      grid-template-columns: minmax(0, 1fr) 280px;
      align-items: center;
      gap: 32px;
    }

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: 48px;
    }
  }

  .quienes-somos__grid--sin-video {
    @media screen and (min-width: 750px) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .quienes-somos__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    min-width: 0;
  }

  .quienes-somos__title {
    margin: 0;
    text-align: center;
  }

  .quienes-somos__logo {
    display: block;
    width: min(var(--logo-width, 280px), 70%);
    height: auto;
  }

  /* Visión y Misión lado a lado desde 990px (el bloque las apila por defecto). */
  .quienes-somos .mision-vision {
    @media screen and (min-width: 990px) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  /* Marco 9:16 con el borde y el radio de antes (4px, 25px). */
  .quienes-somos__media {
    position: relative;
    justify-self: center;
    width: min(100%, 320px);
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border: 4px solid var(--bs-turquoise-soft);
    border-radius: 25px;
    background-color: #fff;

    @media screen and (min-width: 750px) {
      justify-self: end;
      width: 100%;
    }
  }

  .quienes-somos__video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Quiénes somos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Ancho del logo",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 280
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Título si la página no tiene",
      "default": "Quiénes somos"
    }
  ],
  "blocks": [
    { "type": "mision-vision" }
  ],
  "max_blocks": 1,
  "presets": [
    {
      "name": "Quiénes somos",
      "blocks": [{ "type": "mision-vision" }]
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
