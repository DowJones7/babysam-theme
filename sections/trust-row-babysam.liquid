{%- comment -%}
  Franja de confianza del home (Envíos seguros / Cuotas sin interés / Tiendas físicas).
  Tarjetas blancas (.babysam-card, assets/base.css, la misma superficie de los testimonios) sobre
  el crema de la página, ícono blanco en círculo --bs-turquoise como las redes del footer (3,2:1).
  Título --bs-text y subtítulo --bs-text-muted (tokens en base.css).
  Con enlace, la tarjeta entera es el <a>. "/#tiendas" abre el panel Nuestras tiendas del header
  (assets/stores-panel.js escucha cualquier enlace a #tiendas).
  Ícono a la izquierda y texto a la derecha en todos los anchos: 3 columnas desde 750px, apiladas
  y compactas en mobile.
{%- endcomment -%}

<div
  class="trust-bs page-width"
  style="--trust-pt: {{ section.settings.padding_top }}px; --trust-pb: {{ section.settings.padding_bottom }}px;"
>
  <ul class="trust-bs__list list-unstyled" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tag = 'div'
        if block.settings.link != blank
          assign tag = 'a'
        endif
      -%}
      <li class="trust-bs__item" {{ block.shopify_attributes }}>
        <{{ tag }}
          class="trust-bs__card babysam-card{% if tag == 'a' %} trust-bs__card--link{% endif %}"
          {% if tag == 'a' %}
            href="{{ block.settings.link }}"
            {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
          {% endif %}
        >
          <span class="trust-bs__icon" aria-hidden="true">
            <svg class="trust-bs__svg" viewBox="0 0 20 20" focusable="false" xmlns="http://www.w3.org/2000/svg">
              {%- render 'icon', icon: block.settings.icon -%}
            </svg>
          </span>
          <span class="trust-bs__text">
            <span class="trust-bs__title">{{ block.settings.title | escape }}</span>
            {%- if block.settings.subtitle != blank -%}
              <span class="trust-bs__subtitle">{{ block.settings.subtitle | escape }}</span>
            {%- endif -%}
            {%- if tag == 'a' and block.settings.open_in_new_tab -%}
              <span class="visually-hidden">(se abre en una pestaña nueva)</span>
            {%- endif -%}
          </span>
        </{{ tag }}>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .trust-bs {
    padding-block: var(--trust-pt) var(--trust-pb);
  }

  .trust-bs__list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;

    @media screen and (min-width: 750px) {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }

  .trust-bs__item {
    display: flex;
  }

  .trust-bs__card {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 14px 16px;
    text-decoration: none;

    @media screen and (min-width: 750px) {
      gap: 16px;
      padding: 20px 22px;
    }
  }

  .trust-bs__card--link {
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .trust-bs__card--link:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgb(90 63 40 / 0.14);
  }

  .trust-bs__card--link:focus-visible {
    outline: 2px solid var(--bs-turquoise);
    outline-offset: 3px;
  }

  .trust-bs__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--bs-turquoise);
    color: #fff;

    @media screen and (min-width: 750px) {
      width: 48px;
      height: 48px;
    }
  }

  .trust-bs__svg {
    width: 24px;
    height: 24px;
    fill: currentcolor;
  }

  .trust-bs__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .trust-bs__title {
    color: var(--bs-text);
    font-family: var(--font-body--family);
    font-size: var(--bs-h3-size);
    font-weight: 600;
    line-height: 1.3;
  }

  .trust-bs__subtitle {
    color: var(--bs-text-muted);
    font-size: var(--bs-small-size);
    line-height: 1.4;
  }

  @media (prefers-reduced-motion: reduce) {
    .trust-bs__card--link {
      transition: none;
    }

    .trust-bs__card--link:hover {
      transform: none;
    }
  }
{% endstylesheet %}

