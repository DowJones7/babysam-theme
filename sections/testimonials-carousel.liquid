{% if section.settings.title != blank %}
  <div style="text-align: center; padding-block: 40px 28px;">
    <h2 class="title inline-richtext home-section-title">
      {{ section.settings.title }}
    </h2>
  </div>
{% endif %}

<div class="testimonials-wrapper page-width">
  <ul
    class="testimonials-carousel"
    id="Slider-{{ section.id }}"
    role="list"
  >
    {%- for block in section.blocks -%}
      <li
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        class="testimonial-card-item"
        {{ block.shopify_attributes }}
        role="listitem"
      >
        <p class="testimonial-card-item__stars" aria-label="{{ block.settings.rating }} de 5 estrellas">
          {% for i in (1..5) %}
            {% if i <= block.settings.rating %}★{% else %}☆{% endif %}
          {% endfor %}
        </p>
        {% if block.settings.quote != blank %}
          <p class="testimonial-card-item__quote">«{{ block.settings.quote }}»</p>
        {% endif %}
        {% if block.settings.author != blank %}
          <p class="testimonial-card-item__author"><strong>{{ block.settings.author }}</strong></p>
        {% endif %}
      </li>
    {%- endfor -%}
  </ul>
</div>

<script>
  (function () {
    var slider = document.getElementById('Slider-{{ section.id }}');
    if (!slider) return;

    var isDown = false;
    var moved = false;
    var startX = 0;
    var startScrollLeft = 0;

    function endDrag() {
      if (!isDown) return;
      isDown = false;
      slider.classList.remove('is-dragging');
      snapToNearest();
    }

    function snapToNearest() {
      var items = slider.querySelectorAll('.testimonial-card-item');
      if (!items.length) return;
      var closest = null;
      var closestDist = Infinity;
      items.forEach(function (item) {
        var dist = Math.abs(item.offsetLeft - slider.scrollLeft);
        if (dist < closestDist) {
          closestDist = dist;
          closest = item;
        }
      });
      if (closest) {
        slider.scrollTo({ left: closest.offsetLeft, behavior: 'smooth' });
      }
    }

    slider.addEventListener('mousedown', function (e) {
      isDown = true;
      moved = false;
      slider.classList.add('is-dragging');
      startX = e.pageX;
      startScrollLeft = slider.scrollLeft;
    });

    slider.addEventListener('mousemove', function (e) {
      if (!isDown) return;
      e.preventDefault();
      var walk = e.pageX - startX;
      if (Math.abs(walk) > 5) moved = true;
      slider.scrollLeft = startScrollLeft - walk;
    });

    slider.addEventListener('mouseup', endDrag);
    slider.addEventListener('mouseleave', endDrag);

    slider.addEventListener(
      'click',
      function (e) {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
        }
        moved = false;
      },
      true
    );
  })();
</script>

{% schema %}
{
  "name": "Testimonios (carrusel)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "default": "Lo que dicen nuestras mamás y papás", "label": "Título" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1",
      "options": [
        { "value": "scheme-1", "label": "Esquema 1" },
        { "value": "scheme-2", "label": "Esquema 2" },
        { "value": "scheme-3", "label": "Esquema 3" },
        { "value": "scheme-4", "label": "Esquema 4" },
        { "value": "scheme-5", "label": "Esquema 5" },
        { "value": "scheme-6", "label": "Esquema 6" },
        { "value": "scheme-7", "label": "Esquema 7" }
      ]
    }
  ],
  "blocks": [
    { "type": "review", "name": "Reseña", "settings": [
      { "type": "range", "id": "rating", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "textarea", "id": "quote", "label": "Testimonio" },
      { "type": "text", "id": "author", "label": "Nombre del cliente" }
    ]}
  ],
  "presets": [
    { "name": "Testimonios (carrusel)", "blocks": [
      { "type": "review" },
      { "type": "review" },
      { "type": "review" }
    ]}
  ]
}
{% endschema %}

{% stylesheet %}
.testimonials-carousel {
  display: flex;
  align-items: flex-start;
  gap: 20px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding: 10px;
  list-style: none;
  margin: 0;
  cursor: grab;
  user-select: none;
}

.testimonials-carousel::-webkit-scrollbar {
  display: none;
}

.testimonials-carousel.is-dragging {
  cursor: grabbing;
  scroll-snap-type: none;
}

.testimonial-card-item {
  flex: 0 0 auto;
  scroll-snap-align: start;
  border: 2px solid var(--color-foreground);
  border-radius: 15px;
  padding: 24px;
  width: 85%;
}

@media screen and (min-width: 750px) {
  .testimonial-card-item {
    width: 45%;
  }
}

@media screen and (min-width: 990px) {
  .testimonial-card-item {
    width: 30%;
  }
}

.testimonial-card-item__stars {
  text-align: center;
  color: #e4a400;
  margin: 0 0 8px;
  font-size: 1.25rem;
}

.testimonial-card-item__quote {
  text-align: center;
  margin: 0 0 12px;
}

.testimonial-card-item__author {
  text-align: center;
  margin: 0;
}
{% endstylesheet %}
