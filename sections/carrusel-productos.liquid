{% if section.settings.title != blank %}
  <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin" style="text-align: center; padding-block: 40px 28px;">
    <h2 class="title inline-richtext home-section-title {{ section.settings.heading_color }} {{ section.settings.heading_size }}">
      {{ section.settings.title }}
    </h2>
  </div>
{% endif %}

<div class="collection-list-wrapper color-{{ section.settings.color_scheme }}">
  <div class="collection-list-header page-width">
    <div class="collection-carousel-row" data-carousel-drag>
      <button type="button" class="collection-carousel-arrow collection-carousel-arrow--prev" data-carousel-prev aria-label="{{ 'accessibility.slideshow_previous' | t }}">
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>

      <ul
        class="collection-carousel"
        id="Slider-{{ section.id }}"
        data-carousel-track
        role="list"
        style="--card-pattern-url: url('{{ 'backupd_catalogo.png' | file_img_url: '400x400' }}');"
      >
        {%- for block in section.blocks -%}
          {% liquid
            assign card_image = blank
            case block.settings.collection.handle
              when 'accesorios'
                assign card_image = section.settings.image_accesorios
              when 'cobijas'
                assign card_image = section.settings.image_cobijas
              when 'coches'
                assign card_image = section.settings.image_coches
              when 'comedores'
                assign card_image = section.settings.image_comedores
              when 'coleccion-mi-primer-dia'
                assign card_image = section.settings.image_mi_primer_dia
              when 'lenceria'
                assign card_image = section.settings.image_lenceria
              when 'panaleras-1'
                assign card_image = section.settings.image_panaleras
              when 'teteros'
                assign card_image = section.settings.image_teteros
              when 'toallas'
                assign card_image = section.settings.image_toallas
              when 'cuidado-materno'
                assign card_image = section.settings.image_cuidado_materno
              when 'lactancia'
                assign card_image = section.settings.image_lactancia
              when 'aseo'
                assign card_image = section.settings.image_aseo
              when 'ajuares'
                assign card_image = section.settings.image_ajuares
              when 'baneras'
                assign card_image = section.settings.image_baneras
              when 'gimnasios'
                assign card_image = section.settings.image_gimnasios
              when 'silla-de-carro'
                assign card_image = section.settings.image_silla_de_carro
              when 'sillas-mecedoras'
                assign card_image = section.settings.image_sillas_mecedoras
            endcase
          %}
          {% liquid
            assign aos_step = forloop.index0 | modulo: 6
            assign aos_delay = aos_step | times: 50
          %}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="collection-card-item"
            {{ block.shopify_attributes }}
            role="listitem"
            data-aos="fade-up"
            data-aos-delay="{{ aos_delay }}"
          >
            {%- render 'card-collection',
              card_collection: block.settings.collection,
              card_image: card_image,
              media_aspect_ratio: section.settings.image_ratio,
              columns: section.settings.columns_desktop,
              extend_height: section.settings.extend_height,
              collection_title_align: section.settings.collection_title_align,
              show_description: section.settings.show_description,
              show_products_count: section.settings.show_products_count -%}
          </li>
        {%- endfor -%}
      </ul>

      <button type="button" class="collection-carousel-arrow collection-carousel-arrow--next" data-carousel-next aria-label="{{ 'accessibility.slideshow_next' | t }}">
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>
    </div>
  </div>
</div>

<script src="{{ 'carousel-controller.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Lista de colecciones",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "default": "Colecciones", "label": "Título" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1",
      "options": [
        { "value": "scheme-1", "label": "Esquema 1" },
        { "value": "scheme-2", "label": "Esquema 2" },
        { "value": "scheme-3", "label": "Esquema 3" },
        { "value": "scheme-4", "label": "Esquema 4" },
        { "value": "scheme-5", "label": "Esquema 5" },
        { "value": "scheme-6", "label": "Esquema 6" },
        { "value": "scheme-7", "label": "Esquema 7" },
        { "value": "scheme-8", "label": "Esquema 8" },
        { "value": "scheme-9", "label": "Esquema 9" },
        { "value": "scheme-10", "label": "Esquema 10" }
      ]
    },
    { "type": "select", "id": "heading_color", "label": "Color del título", "default": "heading", "options": [
      { "value": "heading", "label": "Color de encabezado" },
      { "value": "accent", "label": "Color de acento" },
      { "value": "subdued", "label": "Color atenuado" }
    ]},
    { "type": "select", "id": "heading_size", "label": "Tamaño de tipografía", "default": "h2", "options": [
      { "value": "h1", "label": "Grande (H1)" },
      { "value": "h2", "label": "Medio (H2)" },
      { "value": "h3", "label": "Pequeño (H3)" }
    ]},
    { "type": "range", "id": "columns_desktop", "min": 1, "max": 6, "default": 4, "label": "Columnas en escritorio" },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "default": 1, "label": "Columnas en móvil" },
    { "type": "checkbox", "id": "swipe_on_mobile", "default": true, "label": "Habilitar deslizamiento en móvil" },
    { "type": "select", "id": "layout_type", "label": "Formato de visualización", "default": "carousel", "options": [
      { "value": "carousel", "label": "Carrusel" },
      { "value": "grid", "label": "Cuadrícula" },
      { "value": "list", "label": "Lista vertical" }
    ]},
    { "type": "select", "id": "image_ratio", "default": "square", "label": "Proporción de imagen", "options": [
      { "value": "square", "label": "1:1" },
      { "value": "portrait", "label": "Retrato" },
      { "value": "landscape", "label": "Paisaje" },
      { "value": "adapt", "label": "Adaptar a imagen" }
    ]},
    { "type": "checkbox", "id": "show_description", "default": false, "label": "Mostrar descripción de la colección" },
    { "type": "checkbox", "id": "show_products_count", "default": false, "label": "Mostrar número de productos" },
    { "type": "checkbox", "id": "extend_height", "default": false, "label": "Extender altura de tarjeta" },
    { "type": "select", "id": "collection_title_align", "label": "Alineación del título", "default": "center", "options": [
      { "value": "left", "label": "Izquierda" },
      { "value": "center", "label": "Centro" },
      { "value": "right", "label": "Derecha" }
    ]},
    { "type": "header", "content": "Fotos de las categorías" },
    { "type": "paragraph", "content": "Sube aquí la foto de cada categoría del catálogo. Si se deja vacía, la tarjeta muestra solo el fondo decorativo, igual que ahora." },
    { "type": "image_picker", "id": "image_accesorios", "label": "Foto de Accesorios" },
    { "type": "image_picker", "id": "image_cobijas", "label": "Foto de Cobijas" },
    { "type": "image_picker", "id": "image_coches", "label": "Foto de Coches" },
    { "type": "image_picker", "id": "image_comedores", "label": "Foto de Comedores" },
    { "type": "image_picker", "id": "image_mi_primer_dia", "label": "Foto de Corrales" },
    { "type": "image_picker", "id": "image_lenceria", "label": "Foto de Lencería" },
    { "type": "image_picker", "id": "image_panaleras", "label": "Foto de Pañaleras" },
    { "type": "image_picker", "id": "image_teteros", "label": "Foto de Teteros" },
    { "type": "image_picker", "id": "image_toallas", "label": "Foto de Toallas" },
    { "type": "image_picker", "id": "image_cuidado_materno", "label": "Foto de Cuidado Materno" },
    { "type": "image_picker", "id": "image_lactancia", "label": "Foto de Lactancia" },
    { "type": "image_picker", "id": "image_aseo", "label": "Foto de Aseo" },
    { "type": "image_picker", "id": "image_ajuares", "label": "Foto de Ajuares" },
    { "type": "image_picker", "id": "image_baneras", "label": "Foto de Bañeras" },
    { "type": "image_picker", "id": "image_gimnasios", "label": "Foto de Gimnasios" },
    { "type": "image_picker", "id": "image_silla_de_carro", "label": "Foto de Silla de carro" },
    { "type": "image_picker", "id": "image_sillas_mecedoras", "label": "Foto de Sillas mecedoras" }
  ],
  "blocks": [
    { "type": "collection", "name": "Colección", "settings": [
      { "type": "collection", "id": "collection", "label": "Colección" }
    ]}
  ],
  "presets": [
    { "name": "Lista de colecciones", "blocks": [
      { "type": "collection" },
      { "type": "collection" },
      { "type": "collection" },
      { "type": "collection" }
    ]}
  ]
}
{% endschema %}

{% stylesheet %}
.collection-carousel-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.collection-carousel {
  display: grid;
  grid-auto-flow: column;
  grid-template-rows: repeat(2, auto);
  /* 2 columnas x 2 filas visibles en mobile */
  grid-auto-columns: calc((100% - 16px) / 2);
  gap: 16px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding: 10px;
  list-style: none;
  margin: 0;
  cursor: grab;
  user-select: none;
  flex: 1;
  min-width: 0;
}

@media screen and (min-width: 750px) {
  .collection-carousel {
    /* 3 columnas x 2 filas visibles en tablet */
    grid-auto-columns: calc((100% - 32px) / 3);
  }
}

@media screen and (min-width: 990px) {
  .collection-carousel {
    /* OPCION A (recomendada): 3 columnas x 2 filas visibles en desktop,
       tarjetas ~380px = igual que la página /collections. Las 18 categorías
       ocupan 9 columnas de tarjeta -> ~3 "pantallas" de drag/navegación. */
    grid-auto-columns: calc((100% - 32px) / 3);
  }
}

.collection-carousel::-webkit-scrollbar {
  display: none;
}

.collection-carousel.is-dragging {
  cursor: grabbing;
  scroll-snap-type: none;
}

.collection-carousel img {
  -webkit-user-drag: none;
  user-drag: none;
  pointer-events: none;
}

.collection-card-item {
  scroll-snap-align: start;
  border: 2px solid var(--bs-turquoise-soft);
  border-radius: 15px;
  overflow: hidden;
  background-image: var(--card-pattern-url);
  background-repeat: repeat;
  background-size: 120px 120px;
  transition: box-shadow 250ms ease;
}

.collection-card-item:hover {
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.15);
}

/* El hover de la tarjeta ahora hace zoom SOLO en la foto de fondo
   (.card-collection__media img), no en toda la tarjeta: scale(1.12) con
   overshoot de 430ms, desactivado durante el drag del carrusel. Esa regla
   vive en assets/babysam-animations.css (junto al resto de la calibración de
   rebote del home) para poder anularla en bloque bajo prefers-reduced-motion.
   Acá se conserva solo el realce de sombra en :hover (ver .collection-card-item
   arriba, con su `transition: box-shadow`). El overlay de título es hermano
   del <img> y no se transforma. */

.collection-carousel .card-collection__title {
  font-size: 1rem;
}

.collection-carousel-arrow {
  display: none;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 2px solid var(--bs-turquoise-soft);
  background: var(--color-background);
  cursor: pointer;
  padding: 0;
}

.collection-carousel-arrow[disabled] {
  opacity: 0.35;
  cursor: default;
}

.collection-carousel-arrow .svg-wrapper {
  display: flex;
  width: 14px;
  height: 14px;
}

.collection-carousel-arrow--prev .svg-wrapper {
  transform: rotate(90deg);
}

.collection-carousel-arrow--next .svg-wrapper {
  transform: rotate(-90deg);
}

@media screen and (min-width: 750px) {
  .collection-carousel-arrow {
    display: flex;
  }
}

.card-collection__title {
  font-size: var(--bs-h3-size);
  font-weight: 600;
  margin: 0 0 4px;
  line-height: 1.2;
}

/* Overlay de título sobre la foto — calibración trasladada del mock
   scratchpad/preview-overlay.html (fotos de prueba: Toallas / Coches /
   Silla de carro / Lencería). Degradado to-top .80 -> .55 (30%) -> 0
   cubriendo ~el 42% inferior de la tarjeta + text-shadow, para que el
   texto blanco sea legible sobre fotos claras (p. ej. lencería pastel). */
.card-collection__overlay {
  position: absolute;
  inset-inline: 0;
  bottom: 0;
  padding: 34px 10px 10px;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.8) 0%,
    rgba(0, 0, 0, 0.55) 30%,
    rgba(0, 0, 0, 0) 100%
  );
  text-align: center;
}

/* especificidad 0,3,0: le gana a `.collection-carousel .card-collection__title`
   (0,2,0) y a su variante en @media(min-width:990px), sin !important */
.collection-carousel .card-collection__overlay .card-collection__title {
  margin: 0;
  /* Título de tarjeta: H3 del sistema de diseño (--bs-h3-size, base.css), igual
     que la página /collections. */
  font-size: var(--bs-h3-size);
  font-weight: 600;
  line-height: 1.2;
  color: #fff;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
}

.card-collection__overlay .card-collection__count {
  margin: 3px 0 0;
  font-size: 0.95rem;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
}
{% endstylesheet %}