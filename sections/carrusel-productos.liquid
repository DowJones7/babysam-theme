{% if section.settings.title != blank %}
  <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin" style="text-align: center; padding-block: 40px 28px;">
    <h2 class="title inline-richtext home-section-title {{ section.settings.heading_color }} {{ section.settings.heading_size }}">
      {{ section.settings.title }}
    </h2>
  </div>
{% endif %}

<div class="collection-list-wrapper color-{{ section.settings.color_scheme }}">
  <div class="collection-list-header page-width">
    <ul
      class="collection-carousel"
      id="Slider-{{ section.id }}"
      role="list"
      style="--card-pattern-url: url('{{ 'backupd_catalogo.png' | file_img_url: '400x400' }}');"
    >
      {%- for block in section.blocks -%}
        {% liquid
          assign card_image = blank
          case block.settings.collection.handle
            when 'accesorios'
              assign card_image = section.settings.image_accesorios
            when 'caminadores'
              assign card_image = section.settings.image_caminadores
            when 'cobijas'
              assign card_image = section.settings.image_cobijas
            when 'coches'
              assign card_image = section.settings.image_coches
            when 'comedores'
              assign card_image = section.settings.image_comedores
            when 'coleccion-mi-primer-dia'
              assign card_image = section.settings.image_mi_primer_dia
            when 'jugueteria'
              assign card_image = section.settings.image_jugueteria
            when 'lenceria'
              assign card_image = section.settings.image_lenceria
            when 'panaleras'
              assign card_image = section.settings.image_panaleras
            when 'panales-premium'
              assign card_image = section.settings.image_panales_premium
            when 'teteros'
              assign card_image = section.settings.image_teteros
            when 'teteros-avent'
              assign card_image = section.settings.image_teteros_avent
            when 'toallas'
              assign card_image = section.settings.image_toallas
          endcase
        %}
        <li
          id="Slide-{{ section.id }}-{{ forloop.index }}"
          class="collection-card-item"
          {{ block.shopify_attributes }}
          role="listitem"
        >
          {%- render 'card-collection',
            card_collection: block.settings.collection,
            card_image: card_image,
            media_aspect_ratio: section.settings.image_ratio,
            columns: section.settings.columns_desktop,
            extend_height: section.settings.extend_height,
            collection_title_align: section.settings.collection_title_align,
            show_description: section.settings.show_description,
            show_products_count: section.settings.show_products_count -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<script>
  (function () {
    var slider = document.getElementById('Slider-{{ section.id }}');
    if (!slider) return;

    var isDown = false;
    var moved = false;
    var startX = 0;
    var startScrollLeft = 0;

    function endDrag() {
      if (!isDown) return;
      isDown = false;
      slider.classList.remove('is-dragging');
      snapToNearest();
    }

    function snapToNearest() {
      var items = slider.querySelectorAll('.collection-card-item');
      if (!items.length) return;
      var closest = null;
      var closestDist = Infinity;
      items.forEach(function (item) {
        var dist = Math.abs(item.offsetLeft - slider.scrollLeft);
        if (dist < closestDist) {
          closestDist = dist;
          closest = item;
        }
      });
      if (closest) {
        slider.scrollTo({ left: closest.offsetLeft, behavior: 'smooth' });
      }
    }

    slider.addEventListener('mousedown', function (e) {
      isDown = true;
      moved = false;
      slider.classList.add('is-dragging');
      startX = e.pageX;
      startScrollLeft = slider.scrollLeft;
    });

    slider.addEventListener('mousemove', function (e) {
      if (!isDown) return;
      e.preventDefault();
      var walk = e.pageX - startX;
      if (Math.abs(walk) > 5) moved = true;
      slider.scrollLeft = startScrollLeft - walk;
    });

    slider.addEventListener('mouseup', endDrag);
    slider.addEventListener('mouseleave', endDrag);

    slider.addEventListener(
      'click',
      function (e) {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
        }
        moved = false;
      },
      true
    );
  })();
</script>

{% schema %}
{
  "name": "Lista de colecciones",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "default": "Colecciones", "label": "Título" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1",
      "options": [
        { "value": "scheme-1", "label": "Esquema 1" },
        { "value": "scheme-2", "label": "Esquema 2" },
        { "value": "scheme-3", "label": "Esquema 3" },
        { "value": "scheme-4", "label": "Esquema 4" },
        { "value": "scheme-5", "label": "Esquema 5" },
        { "value": "scheme-6", "label": "Esquema 6" },
        { "value": "scheme-7", "label": "Esquema 7" },
        { "value": "scheme-8", "label": "Esquema 8" },
        { "value": "scheme-9", "label": "Esquema 9" },
        { "value": "scheme-10", "label": "Esquema 10" }
      ]
    },
    { "type": "select", "id": "heading_color", "label": "Color del título", "default": "heading", "options": [
      { "value": "heading", "label": "Color de encabezado" },
      { "value": "accent", "label": "Color de acento" },
      { "value": "subdued", "label": "Color atenuado" }
    ]},
    { "type": "select", "id": "heading_size", "label": "Tamaño de tipografía", "default": "h2", "options": [
      { "value": "h1", "label": "Grande (H1)" },
      { "value": "h2", "label": "Medio (H2)" },
      { "value": "h3", "label": "Pequeño (H3)" }
    ]},
    { "type": "range", "id": "columns_desktop", "min": 1, "max": 6, "default": 4, "label": "Columnas en escritorio" },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "default": 1, "label": "Columnas en móvil" },
    { "type": "checkbox", "id": "swipe_on_mobile", "default": true, "label": "Habilitar deslizamiento en móvil" },
    { "type": "select", "id": "layout_type", "label": "Formato de visualización", "default": "carousel", "options": [
      { "value": "carousel", "label": "Carrusel" },
      { "value": "grid", "label": "Cuadrícula" },
      { "value": "list", "label": "Lista vertical" }
    ]},
    { "type": "select", "id": "image_ratio", "default": "square", "label": "Proporción de imagen", "options": [
      { "value": "square", "label": "1:1" },
      { "value": "portrait", "label": "Retrato" },
      { "value": "landscape", "label": "Paisaje" },
      { "value": "adapt", "label": "Adaptar a imagen" }
    ]},
    { "type": "checkbox", "id": "show_description", "default": false, "label": "Mostrar descripción de la colección" },
    { "type": "checkbox", "id": "show_products_count", "default": false, "label": "Mostrar número de productos" },
    { "type": "checkbox", "id": "extend_height", "default": false, "label": "Extender altura de tarjeta" },
    { "type": "select", "id": "collection_title_align", "label": "Alineación del título", "default": "center", "options": [
      { "value": "left", "label": "Izquierda" },
      { "value": "center", "label": "Centro" },
      { "value": "right", "label": "Derecha" }
    ]},
    { "type": "header", "content": "Fotos de las categorías" },
    { "type": "paragraph", "content": "Sube aquí la foto de cada categoría del catálogo. Si se deja vacía, la tarjeta muestra solo el fondo decorativo, igual que ahora." },
    { "type": "image_picker", "id": "image_accesorios", "label": "Foto de Accesorios" },
    { "type": "image_picker", "id": "image_caminadores", "label": "Foto de Caminadores" },
    { "type": "image_picker", "id": "image_cobijas", "label": "Foto de Cobijas" },
    { "type": "image_picker", "id": "image_coches", "label": "Foto de Coches" },
    { "type": "image_picker", "id": "image_comedores", "label": "Foto de Comedores" },
    { "type": "image_picker", "id": "image_mi_primer_dia", "label": "Foto de Mi Primer Día" },
    { "type": "image_picker", "id": "image_jugueteria", "label": "Foto de Juguetería" },
    { "type": "image_picker", "id": "image_lenceria", "label": "Foto de Lencería" },
    { "type": "image_picker", "id": "image_panaleras", "label": "Foto de Pañaleras" },
    { "type": "image_picker", "id": "image_panales_premium", "label": "Foto de Pañales Premium" },
    { "type": "image_picker", "id": "image_teteros", "label": "Foto de Teteros" },
    { "type": "image_picker", "id": "image_teteros_avent", "label": "Foto de Teteros Avent" },
    { "type": "image_picker", "id": "image_toallas", "label": "Foto de Toallas" }
  ],
  "blocks": [
    { "type": "collection", "name": "Colección", "settings": [
      { "type": "collection", "id": "collection", "label": "Colección" }
    ]}
  ],
  "presets": [
    { "name": "Lista de colecciones", "blocks": [
      { "type": "collection" },
      { "type": "collection" },
      { "type": "collection" },
      { "type": "collection" }
    ]}
  ]
}
{% endschema %}

{% stylesheet %}
.collection-carousel {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding: 10px;
  list-style: none;
  margin: 0;
  cursor: grab;
  user-select: none;
}

.collection-carousel::-webkit-scrollbar {
  display: none;
}

.collection-carousel.is-dragging {
  cursor: grabbing;
  scroll-snap-type: none;
}

.collection-carousel img {
  -webkit-user-drag: none;
  user-drag: none;
  pointer-events: none;
}

.collection-card-item {
  flex: 0 0 auto;
  scroll-snap-align: start;
  border: 2px solid var(--color-foreground);
  border-radius: 15px;
  overflow: hidden;
  background-image: var(--card-pattern-url);
  background-repeat: repeat;
  background-size: 120px 120px;
  width: 68%;
}

@media screen and (min-width: 750px) {
  .collection-card-item {
    width: 40%;
  }
}

@media screen and (min-width: 990px) {
  .collection-card-item {
    width: 33%;
  }
}

.card-collection__title {
  font-size: 1.35rem;
  font-weight: 600;
  margin: 0 0 4px;
  line-height: 1.2;
}
{% endstylesheet %}