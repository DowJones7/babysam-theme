{%- doc -%}
  Renders a contact form with name, email, phone, and comment fields.

  Versión Babysam (clase `contact-form--babysam`, todo el CSS de abajo cuelga de ella y no toca
  otros formularios del sitio): campos con ícono, píldoras, foco turquesa, validación en español
  antes de enviar (assets/contact-form-babysam.js, el formulario va con `novalidate`), tarjetas
  de éxito/error y acceso a WhatsApp debajo (snippets/whatsapp-url.liquid).

  Es el formulario nativo de Shopify (`form 'contact'`): los envíos llegan al correo de contacto
  de la tienda (Configuración → Datos de la tienda).

  @param {object} settings - Block settings, required for the 'spacing-style' and 'size-style' snippets.
  @param {string} submit_button - HTML for the submit button, rendered via a `content_for` block.

  @example
  {% render 'contact-form', settings: block.settings, submit_button: content_for_submit_button %}
{%- enddoc -%}

<div
  class="
    contact-form contact-form--babysam form--babysam
    spacing-style size-style
    {% if settings.inherit_color_scheme == false %}color-{{ settings.color_scheme }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: settings %}
    {% render 'size-style', settings: settings %}
  "
  {{ block.shopify_attributes }}
>
  {% assign form_id = block.id | default: section.id | prepend: 'ContactForm-' %}

  <script src="{{ 'contact-form-babysam.js' | asset_url }}" type="module" fetchpriority="low"></script>

  {%- form 'contact', id: form_id, class: 'contact-form__form', novalidate: 'novalidate', data-babysam-contact: 'true' -%}
    {%- if form.errors -%}
      <div
        class="contact-form__error"
        role="alert"
        tabindex="-1"
        autofocus
      >
        {{- 'icon-error.svg' | inline_asset_content -}}
        <span>
          {%- if form.errors contains 'email' -%}
            Revisa tu correo electrónico: parece que falta o no es válido.
          {%- else -%}
            No pudimos enviar tu mensaje. Revisa los datos e inténtalo de nuevo.
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}

    {%- if form.posted_successfully? -%}
      <div
        class="contact-form__success"
        role="status"
        tabindex="-1"
        autofocus
      >
        {{- 'icon-checkmark.svg' | inline_asset_content -}}
        <span>¡Gracias! 💕 Recibimos tu mensaje y te responderemos pronto</span>
      </div>
    {%- endif -%}

    <div class="contact-form__form-row">
      <div class="contact-form__field form-babysam__field">
        <label
          class="visually-hidden"
          for="ContactForm-name"
        >
          {{- 'blocks.contact_form.name' | t -}}
        </label>
        <span class="contact-form__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-6 8-6s8 2 8 6"/></svg>
        </span>
        <input
          type="text"
          id="ContactForm-name"
          class="contact-form__input form-babysam__input"
          autocomplete="name"
          name="contact[name]"
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
          placeholder="{{ 'blocks.contact_form.name' | t }}"
        >
      </div>

      <div class="contact-form__field form-babysam__field">
        <label
          class="visually-hidden"
          for="ContactForm-email"
        >
          {{- 'blocks.contact_form.email' | t -}}
          <span aria-hidden="true">*</span></label
        >
        <span class="contact-form__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg>
        </span>
        <input
          type="email"
          id="ContactForm-email"
          class="contact-form__input form-babysam__input"
          autocomplete="email"
          name="contact[email]"
          spellcheck="false"
          autocapitalize="off"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          aria-required="true"
          aria-describedby="ContactForm-email-error"
          {% if form.errors contains 'email' %}
            aria-invalid="true"
          {% endif %}
          placeholder="{{ 'blocks.contact_form.email' | t }}"
          data-babysam-rule="email"
          data-babysam-required
        >
        <p class="contact-form__field-error form-babysam__error" id="ContactForm-email-error" {% unless form.errors contains 'email' %}hidden{% endunless %}>
          {%- if form.errors contains 'email' -%}Revisa tu correo: debe verse como nombre@correo.com.{%- endif -%}
        </p>
      </div>
    </div>

    <div class="contact-form__field form-babysam__field">
      <label
        class="visually-hidden"
        for="ContactForm-phone"
      >
        {{- 'blocks.contact_form.phone' | t -}}
      </label>
      <span class="contact-form__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M11 18h2"/></svg>
      </span>
      <input
        type="tel"
        id="ContactForm-phone"
        class="contact-form__input form-babysam__input"
        autocomplete="tel"
        inputmode="tel"
        name="contact[phone]"
        pattern="[0-9+\-\s()]*"
        value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
        placeholder="{{ 'blocks.contact_form.phone' | t }}"
        aria-describedby="ContactForm-phone-error"
        data-babysam-rule="phone"
      >
      <p class="contact-form__field-error form-babysam__error" id="ContactForm-phone-error" hidden></p>
    </div>

    <div class="contact-form__field contact-form__field--textarea form-babysam__field">
      <label
        class="visually-hidden"
        for="ContactForm-body"
      >
        {{- 'blocks.contact_form.comment' | t -}}
      </label>
      <span class="contact-form__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M20 12a8 8 0 0 1-11.6 7.1L4 20l1-4A8 8 0 1 1 20 12Z"/></svg>
      </span>
      <textarea
        rows="10"
        id="ContactForm-body"
        class="contact-form__input contact-form__input--textarea form-babysam__input form-babysam__textarea"
        name="contact[body]"
        placeholder="{{ 'blocks.contact_form.comment' | t }}"
      >
        {{- form.body -}}
      </textarea>
    </div>

    {{ submit_button }}
  {%- endform -%}

  {%- if settings.whatsapp_number != blank -%}
    {%- liquid
      assign wa_mensaje = '¡Hola! 👋💕 Vengo de la página de contacto de Babysam y tengo una pregunta 😊'
      assign wa_label = settings.whatsapp_label | default: 'Escríbenos por WhatsApp'
    -%}
    <div class="contact-form__whatsapp">
      {%- if settings.whatsapp_intro != blank -%}
        <p class="contact-form__whatsapp-intro">{{ settings.whatsapp_intro | escape }}</p>
      {%- endif -%}
      <a
        class="contact-form__whatsapp-button button--babysam-wa"
        href="{% render 'whatsapp-url', number: settings.whatsapp_number, message: wa_mensaje %}"
        target="_blank"
        rel="noopener"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M12 2a10 10 0 0 0-8.6 15.09L2 22l5.05-1.32A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3 .78.8-2.92-.2-.31A8.2 8.2 0 1 1 12 20.2Z" />
          <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.38-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.07-.13-.27-.2-.57-.35Z" />
        </svg>
        <span>{{ wa_label | escape }}</span>
        <span class="visually-hidden">(se abre WhatsApp en una pestaña nueva)</span>
      </a>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .contact-form__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .contact-form__form-row {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);

    @media screen and (min-width: 750px) {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .contact-form__input {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-foreground);
    background-color: var(--color-input-background);
    padding: var(--padding-lg) var(--padding-xl);
    border-radius: var(--style-border-radius-inputs);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    -webkit-font-smoothing: antialiased;
  }

  .contact-form__input--textarea {
    resize: vertical;
    min-height: var(--input-textarea-min-height);
  }

  .contact-form__error,
  .contact-form__success {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
  }

  /* ---------- Versión Babysam ----------
     Campos, foco, errores y etiquetas: .form--babysam (assets/base.css), compartido con el
     formulario de Baby Shower. Botón verde: .button--babysam-wa (assets/base.css). Acá solo lo
     propio del contacto: íconos dentro de los campos, tarjetas de éxito/error, botón carmesí y
     el acceso a WhatsApp. */
  .contact-form--babysam {
    /* Carmesí del botón un poco más profundo que #e44068 (4,01:1 con blanco, no pasa AA):
       #d2345b da 4,79:1; hover #bc3454 (5,59:1), el mismo hover del botón primario. */
    --babysam-carmesi: #d2345b;
    --babysam-carmesi-hover: #bc3454;
  }

  .contact-form--babysam .contact-form__icon {
    position: absolute;
    top: 0;
    inset-inline-start: 1.1rem;
    display: flex;
    align-items: center;
    height: 48px;
    color: rgb(90 63 40 / 0.55);
    pointer-events: none;
    transition: color var(--babysam-transicion);
  }

  .contact-form--babysam .contact-form__field--textarea .contact-form__icon {
    height: auto;
    top: calc(var(--padding-md) + 0.15em);
  }

  .contact-form--babysam .contact-form__icon svg {
    width: 20px;
    height: 20px;
  }

  /* Espacio para el ícono: (0,3,0) para ganarle al padding de .form--babysam. */
  .contact-form--babysam .contact-form__field .contact-form__input {
    padding-inline-start: 3rem;
  }

  .contact-form--babysam .contact-form__field:focus-within .contact-form__icon {
    color: var(--babysam-turquesa-foco);
  }

  .contact-form--babysam :is(.contact-form__error, .contact-form__success) {
    padding: var(--padding-md) var(--padding-lg);
    border-radius: 16px;
    font-weight: 600;
    line-height: 1.4;
  }

  .contact-form--babysam .contact-form__success {
    background-color: rgb(120 192 179 / 0.18);
    border: 1.5px solid var(--babysam-turquesa);
    color: var(--babysam-texto);
  }

  .contact-form--babysam .contact-form__error {
    background-color: rgb(139 0 0 / 0.06);
    border: 1.5px solid var(--color-error);
    color: var(--color-error);
  }

  .contact-form--babysam :is(.contact-form__error, .contact-form__success) svg {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
  }

  /* Botón "Enviar mensaje": el bloque contact-form-submit-button usa .button, que pinta con
     estas variables; se sobreescriben solo acá. */
  .contact-form--babysam .submit-button.button {
    --button-background-color: var(--babysam-carmesi);
    --button-color: #fff;
    --button-border-color: var(--babysam-carmesi);

    align-self: flex-start;
    min-height: 48px;
    padding-inline: var(--padding-4xl);
    border-radius: 999px;
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: 0.01em;
    transition: background-color var(--babysam-transicion), box-shadow var(--babysam-transicion),
      transform var(--babysam-transicion);
  }

  .contact-form--babysam .submit-button.button:hover:not(:disabled) {
    --button-background-color: var(--babysam-carmesi-hover);
    --button-border-color: var(--babysam-carmesi-hover);

    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgb(188 52 84 / 0.3);
  }

  .contact-form--babysam .submit-button.button:focus-visible {
    outline: 2px solid var(--babysam-turquesa-foco);
    outline-offset: 3px;
  }

  .contact-form--babysam .submit-button.button:disabled {
    opacity: 0.75;
    cursor: progress;
  }

  @media screen and (max-width: 749px) {
    .contact-form--babysam .submit-button.button {
      align-self: stretch;
      width: 100%;
    }
  }

  /* WhatsApp debajo del formulario (el botón es .button--babysam-wa). */
  .contact-form--babysam .contact-form__whatsapp {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-sm);
    margin-block-start: var(--margin-2xl);
    padding-block-start: var(--padding-xl);
    border-top: 1px solid rgb(90 63 40 / 0.14);
  }

  .contact-form--babysam .contact-form__whatsapp-intro {
    margin: 0;
    color: var(--babysam-texto);
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .contact-form--babysam .contact-form__whatsapp-button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-form--babysam :is(.contact-form__icon, .submit-button) {
      transition: none;
    }

    .contact-form--babysam .submit-button.button:hover:not(:disabled) {
      transform: none;
    }
  }
{% endstylesheet %}
