{% comment %}
  Snippet: card-collection.liquid
  Muestra una tarjeta de colección con imagen, título y contador de productos
{% endcomment %}

{% assign collection = card_collection %}

{% liquid
  assign card_ratio = '1 / 1'
  case media_aspect_ratio
    when 'portrait'
      assign card_ratio = '4 / 5'
    when 'landscape'
      assign card_ratio = '16 / 9'
  endcase
%}

{% if collection != blank %}
  <a
    href="{{ collection.url }}"
    class="card-collection{% if card_image != blank %} card-collection--overlay{% endif %}"
    style="display:block; text-align:center;">
    <div
      class="card-collection__media"
      style="position:relative; overflow:hidden; border-radius:15px; aspect-ratio: {{ card_ratio }}; margin-bottom: {% if card_image != blank %}0{% else %}14px{% endif %};">
      {% if card_image != blank %}
        <img
          src="{{ card_image | image_url: width: 600 }}"
          alt="{{ card_image.alt | default: collection.title | escape }}"
          style="width:100%; height:100%; object-fit:cover; display:block;">
        {% comment %} Overlay de título sobre la foto — calibración del mock preview-overlay.html {% endcomment %}
        <div class="card-collection__overlay">
          <h3 class="card-collection__title">{{ collection.title }}</h3>
          {% if show_products_count %}
            <p class="card-collection__count">{{ collection.products_count }} productos</p>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% comment %} Sin foto: se conserva el título debajo, sobre el mosaico de fondo {% endcomment %}
    {% unless card_image != blank %}
      <h3 class="card-collection__title">{{ collection.title }}</h3>

      {% if show_products_count %}
        <p style="font-size:0.9em; color: var(--bs-text-muted);">
          {{ collection.products_count }} productos
        </p>
      {% endif %}
    {% endunless %}

    {% if show_description and collection.description != blank %}
      <p style="font-size:0.9em;">{{ collection.description }}</p>
    {% endif %}
  </a>
{% endif %}