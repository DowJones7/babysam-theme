{%- doc -%}
  Tarjeta de invitación a hablar con un asesor por WhatsApp, pensada para ir como último
  elemento de una cuadrícula de productos (hoy: "Personaliza tu lencería" en
  sections/main-collection.liquid). Mismo borde y radio que la galería de las tarjetas de
  producto, con fondo turquesa suave para que se lea como invitación y no como producto.
  El <li> lo pone quien la usa (lleva los atributos del scroll infinito).

  @param {string} title - Título de la tarjeta.
  @param {string} [text] - Texto de apoyo.
  @param {string} button_label - Texto del botón.
  @param {string} number - Número de WhatsApp (ver snippets/whatsapp-url.liquid).
  @param {string} [message] - Mensaje precargado de WhatsApp.

  @example
  {% render 'whatsapp-invite-card', title: 'Personaliza tu lencería', button_label: 'Hablar con un asesor', number: '573102367180' %}
{%- enddoc -%}

<div class="whatsapp-invite-card">
  {%- comment -%} Osito de peluche, trazo simple: decorativo. {%- endcomment -%}
  <svg class="whatsapp-invite-card__icon" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <circle cx="17" cy="16" r="7"/>
    <circle cx="47" cy="16" r="7"/>
    <circle cx="32" cy="30" r="17"/>
    <ellipse cx="32" cy="36" rx="7.5" ry="5.5"/>
    <circle cx="25.5" cy="26.5" r="1.4" fill="currentColor"/>
    <circle cx="38.5" cy="26.5" r="1.4" fill="currentColor"/>
    <path d="M32 34.5v2.5M29.5 38.5c1.5 1.3 3.5 1.3 5 0"/>
    <path d="M22 45l-3 12M42 45l3 12"/>
  </svg>

  <h3 class="whatsapp-invite-card__title">{{ title | escape }}</h3>

  {%- if text != blank -%}
    <p class="whatsapp-invite-card__text">{{ text | escape }}</p>
  {%- endif -%}

  <a
    class="button--babysam-wa whatsapp-invite-card__button"
    href="{% render 'whatsapp-url', number: number, message: message %}"
    target="_blank"
    rel="noopener"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M12 2a10 10 0 0 0-8.6 15.09L2 22l5.05-1.32A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3 .78.8-2.92-.2-.31A8.2 8.2 0 1 1 12 20.2Z" />
      <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.38-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.07-.13-.27-.2-.57-.35Z" />
    </svg>
    <span>{{ button_label | escape }}</span>
    <span class="visually-hidden">(se abre WhatsApp en una pestaña nueva)</span>
  </a>
</div>
